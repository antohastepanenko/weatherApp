@using WeatherApp.Contracts
<section class="weather-section" aria-labelledby="daily-heading">
    <div class="section-heading"><div><p class="eyebrow">На несколько дней</p><h2 id="daily-heading">Прогноз на 3 дня</h2></div></div>
    <div class="daily-grid">
        @foreach (var day in Days)
        {
            <article class="day-card">
                <div class="day-card-header"><h3>@day.Date.ToString("ddd, d MMM")</h3>@if (!string.IsNullOrWhiteSpace(day.IconUrl)) { <img class="weather-icon" src="@day.IconUrl" alt="@day.ConditionText" /> }</div>
                <p>@day.ConditionText</p>
                <div class="day-temperatures"><strong>@Format(day.MaxTemperatureC)°</strong><span>@Format(day.MinTemperatureC)°</span></div>
                <small>Дождь @Format(day.ChanceOfRain)%</small>
                <small>Восход @Format(day.Sunrise) · закат @Format(day.Sunset)</small>
            </article>
        }
    </div>
</section>

@code {
    /// <summary>Дневные сводки для отображения.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<DailyWeather> Days { get; set; } = [];

    /// <summary>Форматирует дробное значение с одной десятичной цифрой или "—", если null.</summary>
    private static string Format(double? value) => value?.ToString("0.#") ?? "—";

    /// <summary>Форматирует целое число или "—", если null.</summary>
    private static string Format(int? value) => value?.ToString() ?? "—";

    /// <summary>Форматирует время суток в "HH:mm" или "—", если null.</summary>
    private static string Format(TimeOnly? value) => value?.ToString("HH:mm") ?? "—";
}